# ==========================================
# Real-Time Metrics Platform Configuration
# Copy this file to .env and configure values
# ==========================================

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realtime_metrics
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_CONNECT_TIMEOUT=5

# Wikimedia Ingestion Stream Settings
WIKIMEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
USER_AGENT=RealtimeMetricsMonitoringPlatform/2.0 (student/portfolio project)
INGEST_BATCH_SIZE=50
INGEST_FLUSH_INTERVAL=1.0
INGEST_HEARTBEAT_INTERVAL=5.0

# Processor & Statistical Anomaly Engine Settings
PROCESSOR_INTERVAL_SECONDS=15
AGGREGATION_WINDOW_MINUTES=30
ANOMALY_LOOKBACK_MINUTES=60
MIN_SAMPLE_COUNT=10
MIN_EDITS_THRESHOLD=5
ZSCORE_THRESHOLD=3.0
